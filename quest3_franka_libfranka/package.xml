<?xml version="1.0"?>
<package format="3">
  <name>quest3_franka_libfranka</name>
  <version>0.1.0</version>
  <description>Direct libfranka Cartesian pose bridge for Quest 3 teleoperation.</description>
  <maintainer email="user@example.com">teleop</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>geometry_msgs</depend>
  <depend>rclcpp</depend>
  <depend>sensor_msgs</depend>
  <depend>std_msgs</depend>

  <build_depend>libfranka</build_depend>
  <exec_depend>libfranka</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
